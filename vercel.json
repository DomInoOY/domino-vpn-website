{
  "rewrites": [
    { "source": "/app",             "destination": "/cabinet.html" },
    { "source": "/sub/:sub_id",     "destination": "/api/me.js" },
    { "source": "/api/me",          "destination": "/api/me.js" },
    { "source": "/api/pay",         "destination": "/api/pay.js" },
    { "source": "/api/pay-check",   "destination": "/api/pay-check.js" },
    { "source": "/api/trial",       "destination": "/api/trial.js" },
    { "source": "/api/promo",       "destination": "/api/promo.js" },
    { "source": "/api/key",         "destination": "/api/key.js" },
    { "source": "/api/referral",    "destination": "/api/referral.js" },
    { "source": "/api/weblogin",    "destination": "/api/weblogin.js" },
    { "source": "/api/refresh",     "destination": "/api/refresh.js" },
    { "source": "/api/logout",      "destination": "/api/account.js" },
    { "source": "/api/login-key",   "destination": "/api/login-key.js" },
    { "source": "/api/account",     "destination": "/api/account.js" },
    { "source": "/api/cron-push",   "destination": "/api/cron-push.js" },
    { "source": "/api/reserve",      "destination": "/api/reserve.js" },
    { "source": "/ref",             "destination": "/ref.html" }
  ],
  "crons": [
    { "path": "/api/cron-push", "schedule": "0 9 * * *" }
  ]
}
